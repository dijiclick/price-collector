# Every value here is supplied by GitHub Actions Secrets in CI.
# Nothing secret is ever committed to this repository.

# Neon Postgres. Without it the collector falls back to an embedded database.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Public OCAPI client id, read from the retailer's own web app.
SEPHORA_CLIENT_ID=

# Residential proxy. The exit country is appended to the USERNAME per request.
DATAIMPULSE_PROXY=http://user:password@gw.dataimpulse.com:823

# Drop-alert email (Resend).
RESEND_API_KEY=
RESEND_FROM=

# Push, sent straight to Apple and Google. CI has no filesystem for key files,
# so these carry the key CONTENTS. Absent = that platform is skipped for the run.
APNS_KEY=
APNS_KEY_ID=
FCM_SERVICE_ACCOUNT=

# Dead-man's switch (e.g. a healthchecks.io URL).
HEALTHCHECK_URL=
